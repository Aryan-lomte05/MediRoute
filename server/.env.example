# ==============================================================================
# MediRoute API — environment template
# Copy to server/.env and fill in. Never commit the filled-in file.
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
# Outside production the API also accepts any localhost origin, so vite dev
# (5173) and vite preview (4173) both work without listing them here.
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mediroute?retryWrites=true&w=majority

# Security — generate a long random value per environment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_value
JWT_EXPIRES_IN=7d

# ── AI ────────────────────────────────────────────────────────────────────────
# Groq provides both clinical triage and speech-to-text. Model IDs are chosen in
# src/services/aiService.js; these variables only override the defaults.
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides. Leave unset to use the verified defaults.
# Chat models must be available on your key — check against
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# A decommissioned model is why triage silently fell back to keyword rules for
# a long time, so verify these when provisioning a new key.
# GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# AI_TIMEOUT_MS=12000

# OpenRouter is an optional extra tier and is OFF unless a model is named.
# The previously used free slug (meta-llama/llama-3.1-8b-instruct:free) now
# returns 404, so a paid slug is required to enable it.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# ── Geospatial ────────────────────────────────────────────────────────────────
MAPBOX_TOKEN=your_mapbox_token_here
OSRM_BASE_URL=https://router.project-osrm.org

# Used for ETA estimates and to bucket the surge forecast by local clock hour.
# AMBULANCE_AVG_KMH=28
# CITY_TIMEZONE=Asia/Kolkata

# ── Communications (Twilio — feature branch only, not used on main) ──────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
