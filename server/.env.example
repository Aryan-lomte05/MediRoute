# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mediroute?retryWrites=true&w=majority

# Security
JWT_SECRET=mediroute_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Engines
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Communications (Twilio - Neil)
# Webhook URLs to configure in the Twilio Console (Messaging Sender / Voice number).
# Locally, expose this server with a tunnel (e.g. `ngrok http 5000`) and set
# PUBLIC_BASE_URL below to the printed https:// tunnel URL:
# All webhook requests must have a valid Twilio signature. There is no local
# signature bypass; use real signed Twilio callbacks through your private tunnel.
# In production, missing PUBLIC_BASE_URL or TWILIO_AUTH_TOKEN rejects webhooks.
#   WhatsApp webhook : {PUBLIC_BASE_URL}/api/twilio/whatsapp
#   Voice webhook    : {PUBLIC_BASE_URL}/api/twilio/voice
#   Voice <Record> action callback (set automatically, no manual config needed):
#                      {PUBLIC_BASE_URL}/api/twilio/voice/recording
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
